@mode(host.native)

# Unit tests for the cpuid text helpers (text.lphc).
#
# Runtime: host.native, run by the test runner: `make test` runs
# `loup-bootstrap test --native`, which compiles each `func test_*()` here,
# with the modules it imports from source/ and tests/ (both on LOUPPATH),
# into its own native binary and runs it. Not part of build/cpuid.

from debug.assert import (expect, expectEq);
from text import (hex, hex_upper, fixed2, size_text, wrap_words, trim_spaces);
from core.string_utils import (padLeft, padRight);
from samples import (expect_text);

func test_hex(): void {
    expect_text(hex(0, 8), "00000000", "zero padded");
    expect_text(hex(0x8000001d, 8), "8000001d", "lower case");
    expect_text(hex(255, 1), "ff", "wider than the width");
    expect_text(hex_upper(0x80000001, 8), "80000001", "upper");
    expect_text(hex_upper(0xab, 2), "AB", "upper digits");
}

# The report columns rely on core.string_utils' pads never truncating: a
# long flag name or location widens its row instead of being cut.
func test_padding(): void {
    expect_text(padRight("ab", 4, " "), "ab  ", "right");
    expect_text(padLeft("ab", 4, " "), "  ab", "left");
    expect_text(padLeft("abcdef", 4, " "), "abcdef", "never truncates");
}

func test_fixed2(): void {
    expect_text(fixed2(1234), "12.34", "two decimals");
    expect_text(fixed2(5), "0.05", "leading zero");
    expect_text(fixed2(100), "1.00", "whole");
}

func test_size_text(): void {
    expect_text(size_text(32768), "32 KiB", "KiB");
    expect_text(size_text(1048576), "1 MiB", "MiB");
    expect_text(size_text(1310720), "1280 KiB", "not a whole MiB");
    expect_text(size_text(100), "100 B", "bytes");
}

func test_wrap_words(): void {
    let words = ["aaaa", "bbbb", "cccc", "dddd"];
    expect_text(wrap_words(words, 12, 2), "aaaa bbbb\n  cccc dddd", "wraps at the width");
    expect_text(wrap_words(["x"], 80, 15), "x", "one word");
    let none: list[string] = [];
    expect_text(wrap_words(none, 80, 0), "", "no words");
}

func test_trim_spaces(): void {
    expect_text(trim_spaces("  a b  "), "a b", "both ends");
    expect_text(trim_spaces("   "), "", "only blanks");
}
