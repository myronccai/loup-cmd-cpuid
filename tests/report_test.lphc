@mode(host.native)

# Unit tests for the cpuid views (commands/report.lphc), rendered from the
# recorded snapshots and fixed benchmark numbers and compared with exact
# expected text.
#
# Runtime: host.native, run by the test runner: `make test` runs
# `loup-bootstrap test --native`, which compiles each `func test_*()` here,
# with the modules it imports from source/ and tests/ (both on LOUPPATH),
# into its own native binary and runs it. Not part of build/cpuid.

from debug.assert import (expect, expectEq);
from cpu.decode import (feature_table, caches, CacheInfo);
from cpu.bench import (BenchResult);
from commands.report import (render_summary, render_caches, render_features,
    render_raw, render_bench, location, cache_text);
from samples import (amd_zen4, amd_legacy, intel_coffee_lake, expect_text);

func test_summary(): void {
    let want = [
        "vendor:        AuthenticAMD",
        "brand:         AMD Ryzen 9 7940HS w/ Radeon 780M Graphics",
        "family:        25 (0x19)",
        "model:         116 (0x74)",
        "stepping:      1",
        "max leaf:      0x10, extended 0x80000028",
        "hypervisor:    none",
        "address sizes: 48 bits physical, 48 bits virtual",
        "flags:         fpu tsc cx8 cmov clflush mmx fxsr sse sse2 ht pni pclmulqdq",
        "               monitor ssse3 fma cx16 sse4_1 sse4_2 movbe popcnt aes xsave",
        "               osxsave avx f16c rdrand fsgsbase bmi1 avx2 smep bmi2 erms invpcid",
        "               avx512f avx512dq rdseed adx smap avx512ifma clflushopt clwb",
        "               avx512cd sha_ni avx512bw avx512vl avx512vbmi umip pku",
        "               avx512_vbmi2 gfni vaes vpclmulqdq avx512_vnni avx512_bitalg",
        "               avx512_vpopcntdq rdpid fsrm avx512_bf16 lahf_lm svm abm sse4a",
        "               3dnowprefetch topoext syscall nx mmxext pdpe1gb rdtscp lm",
        "               nonstop_tsc",
        "L1d cache:     32 KiB, 8-way, 64-byte lines, shared by 2 threads",
        "L1i cache:     32 KiB, 8-way, 64-byte lines, shared by 2 threads",
        "L2 cache:      1 MiB, 8-way, 64-byte lines, shared by 2 threads",
        "L3 cache:      16 MiB, 16-way, 64-byte lines, shared by 16 threads",
    ];
    expect_text(render_summary(amd_zen4()), want.join("\n"), "summary");
}

func test_summary_lines_fit_80_columns(): void {
    for (line in render_summary(intel_coffee_lake()).split("\n")) {
        expect(line.len() <= 80, i"line too long: {$ line $}");
    }
}

func test_caches_view(): void {
    let want = [
        "L1d cache:     32 KiB, 8-way, 64-byte lines",
        "L1i cache:     32 KiB, 8-way, 64-byte lines",
        "L2 cache:      1 MiB, 8-way, 64-byte lines",
        "L3 cache:      16 MiB, 64-byte lines",
    ];
    expect_text(render_caches(amd_legacy()), want.join("\n"), "legacy caches: no sharing, L3 ways unknown");
    let full = CacheInfo(level = 1, kind = "data", size = 4096, ways = 0, line = 64, shared_by = 1);
    expect_text(cache_text(full), "4 KiB, fully associative, 64-byte lines, 1 thread", "fully associative");
}

func test_feature_view(): void {
    let lines = render_features(amd_zen4()).split("\n");
    expectEq(lines.len(), feature_table().len() + 1, "header plus one line per flag");
    expect_text(lines[0], "flag                 has  cpuid             description", "header");
    expect_text(lines[1], "fpu                  yes  01H.EDX[0]        x87 floating-point unit", "first flag");
    expect(lines[14].startsWith("vmx                  no   01H.ECX[5]"), "an absent flag");
}

func test_locations(): void {
    let table = feature_table();
    for (feat in table) {
        let loc = location(feat);
        if (feat.name == "sse2") {
            expect_text(loc, "01H.EDX[26]", "leaf 1");
        } else if (feat.name == "avx2") {
            expect_text(loc, "07H.0.EBX[5]", "leaf 7 subleaf 0");
        } else if (feat.name == "avx512_bf16") {
            expect_text(loc, "07H.1.EAX[5]", "leaf 7 subleaf 1");
        } else if (feat.name == "lm") {
            expect_text(loc, "80000001H.EDX[29]", "extended leaf");
        }
    }
}

func test_raw_view(): void {
    let lines = render_raw(amd_zen4()).split("\n");
    expect_text(lines[0], "leaf      sub  eax       ebx       ecx       edx", "header");
    expect_text(lines[1], "00000000  0    00000010  68747541  444d4163  69746e65", "leaf 0");
    expect_text(lines[18], "8000001d  3    0003c163  03c0003f  00003fff  00000001", "last subleaf");
}

func test_bench_view(): void {
    let results = [
        BenchResult(name = "int add", iterations = 1000, best_cycles = 1000, hundredths = 100),
        BenchResult(name = "pointer chase", iterations = 1000, best_cycles = 300000, hundredths = 30000),
    ];
    let want = [
        "TSC: 4000 MHz, invariant",
        "best of 5 runs, in TSC reference cycles",
        "",
        "kernel          iterations  cycles/iter    ns/iter",
        "int add               1000         1.00       0.25",
        "pointer chase         1000       300.00      75.00",
    ];
    expect_text(render_bench(results, 4000, true), want.join("\n"), "bench table");
    expect(render_bench(results, 0, false).contains("not invariant"), "variable TSC");
}
