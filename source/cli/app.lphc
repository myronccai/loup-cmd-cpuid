@mode(host.native)

# Top level of cpuid: parse the arguments, answer --help and --version, run
# the selected view and turn an exception into exit status 1.
#
# Runtime: host.native. Compiled into the native binary build/cpuid by
# `make build` (Stage0, `loup-bootstrap build --target native`).
# tests/app_test.lphc calls run() inside native test binaries, so the views
# really execute CPUID there too.

from appinfo import (APP_NAME, EXIT_OK, EXIT_FAILURE, EXIT_USAGE);
from cli.args import (parse_args);
from cli.usage import (usage, version_line);
from commands.report import (run_cpuid);

# Parses argv, runs the report and returns the exit status.
pub func run(argv: list[string]): int {
    let opts = match parse_args(argv) {
        Ok(parsed) => parsed,
        Err(msg) => {
            printErr(i"{$ APP_NAME $}: {$ msg $}");
            printErr(i"Try '{$ APP_NAME $} --help' for more information.");
            return EXIT_USAGE;
        },
    };

    if (opts.help) {
        println(usage());
        return EXIT_OK;
    }
    if (opts.version) {
        println(version_line());
        return EXIT_OK;
    }

    try {
        return run_cpuid(opts);
    } catch (Exception as e) {
        printErr(i"{$ APP_NAME $}: {$ e.message $}");
        return EXIT_FAILURE;
    }
}
