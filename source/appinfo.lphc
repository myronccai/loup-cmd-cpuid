@mode(host.native)

# Application identity. Keep APP_NAME and APP_VERSION in step with `name`
# and `version` in package.lppkg.

pub const APP_NAME: string = "cpuid";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Report what the x86-64 processor says about itself through CPUID, and time instructions with RDTSC.";

# Exit statuses returned by main().
pub const EXIT_OK: int = 0;
pub const EXIT_FAILURE: int = 1;
pub const EXIT_USAGE: int = 2;

# `--has FLAG` when the flag is absent, as grep reports no match.
pub const EXIT_ABSENT: int = 1;
