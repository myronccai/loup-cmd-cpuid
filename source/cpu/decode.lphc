        f("tbm", e1, 0, "ecx", 21, "trailing bit manipulation"),
        f("topoext", e1, 0, "ecx", 22, "topology extensions (leaf 0x8000001D)"),
        f("syscall", e1, 0, "edx", 11, "SYSCALL and SYSRET"),
        f("nx", e1, 0, "edx", 20, "no-execute page protection"),
        f("mmxext", e1, 0, "edx", 22, "AMD MMX extensions"),
        f("pdpe1gb", e1, 0, "edx", 26, "1 GiB pages"),
        f("rdtscp", e1, 0, "edx", 27, "RDTSCP"),
        f("lm", e1, 0, "edx", 29, "long mode (x86-64)"),
        f("nonstop_tsc", e7, 0, "edx", 8, "invariant TSC: constant rate in every P- and C-state"),
    ];
}

pub func feature_present(snap: Snapshot, feat: Feature): bool {
    # A leaf above the reported maximum is not valid, whatever it reads as.
    let max = if (feat.leaf >= EXTENDED_BASE) { max_extended_leaf(snap) } else { max_basic_leaf(snap) };
    if (feat.leaf > max) {
        return false;
    }
    let value = reg_value(lookup(snap, feat.leaf, feat.subleaf), feat.reg);
    return ((value >> feat.bit) & 1) == 1;
}

pub func features(snap: Snapshot): list[FeatureState] {
    var out: list[FeatureState] = [];
    for (feat in feature_table()) {
        out.push(FeatureState(feature = feat, present = feature_present(snap, feat)));
    }
    return out;
}

# Names of the flags that are present, in table order.
pub func present_flags(snap: Snapshot): list[string] {
    var names: list[string] = [];
    for (state in features(snap)) {
        if (state.present) {
            names.push(state.feature.name);
        }
    }
    return names;
}

# Some(true/false) for a known flag name, None for an unknown one.
pub func has_flag(snap: Snapshot, name: string): Option[bool] {
    for (feat in feature_table()) {
        if (feat.name == name) {
            return Some(feature_present(snap, feat));
        }
    }
    return None;
}

# ---------------------------------------------------------------------------
# Caches

pub struct CacheInfo {
    pub level: int;
    # "data", "instruction" or "unified"
    pub kind: string;
    pub size: int;
    # 0 when fully associative, -1 when not reported
    pub ways: int;
    pub line: int;
    # threads sharing the cache; 0 when not reported
    pub shared_by: int;
}

# "L1d", "L1i", "L2", ...
pub func cache_label(c: CacheInfo): string {
    let suffix = if (c.kind == "data") { "d" } else if (c.kind == "instruction") { "i" } else { "" };
    return "L" + str(c.level) + suffix;
}

# Decodes one leaf-4-format subleaf (Intel leaf 4, AMD leaf 0x8000001D), or
# None for cache type 0 (no more caches).
pub func decode_cache_leaf(r: Regs): Option[CacheInfo] {
    let kind_code = r.eax & 0x1F;
    if (kind_code == 0) {
        return None;
    }
    let kind = match kind_code {
        1 => "data",
        2 => "instruction",
        _ => "unified",
    };
    let level = (r.eax >> 5) & 0x7;
    let fully = ((r.eax >> 9) & 1) == 1;
    let shared_by = ((r.eax >> 14) & 0xFFF) + 1;
    let line = (r.ebx & 0xFFF) + 1;
    let partitions = ((r.ebx >> 12) & 0x3FF) + 1;
    let ways = ((r.ebx >> 22) & 0x3FF) + 1;
    let sets = r.ecx + 1;
    return Some(CacheInfo(
        level = level,
        kind = kind,
        size = ways * partitions * line * sets,
        ways = if (fully) { 0 } else { ways },
        line = line,
        shared_by = shared_by,
    ));
}

func caches_from_leaf(snap: Snapshot, leaf: int): list[CacheInfo] {
    var out: list[CacheInfo] = [];
    for (entry in snap.leaves) {
        if (entry.leaf == leaf) {
            match decode_cache_leaf(entry.regs) {
                Some(c) => { out.push(c); },
                None => {},
            }
        }
    }
    return out;
}

# AMD's associativity code in 0x80000006 (L2 and L3): 15 is fully
# associative (0 ways); 9 ("see leaf 0x8000001D") and reserved codes are
# not reported (-1). The arms are decimal: a hex literal pattern never
# matches in Loup 1.26.0.
pub func amd_ways(code: int): int {
    return match code {
        1 => 1,
        2 => 2,
        3 => 3,
        4 => 4,
        5 => 6,
        6 => 8,
        8 => 16,
        10 => 32,
        11 => 48,
        12 => 64,
        13 => 96,
        14 => 128,
        15 => 0,
        _ => -1,
    };
}

# The legacy AMD leaves 0x80000005 (L1) and 0x80000006 (L2, L3). They do not
# report sharing.
pub func legacy_amd_caches(snap: Snapshot): list[CacheInfo] {
    var out: list[CacheInfo] = [];
    let max = max_extended_leaf(snap);
    if (max >= EXTENDED_BASE + 5) {
        let l1 = lookup(snap, EXTENDED_BASE + 5, 0);
        if ((l1.ecx >> 24) > 0) {
            let ways = (l1.ecx >> 16) & 0xFF;
            out.push(CacheInfo(level = 1, kind = "data", size = (l1.ecx >> 24) * 1024,
                ways = if (ways == 0xFF) { 0 } else { ways }, line = l1.ecx & 0xFF, shared_by = 0));
        }
        if ((l1.edx >> 24) > 0) {
            let ways = (l1.edx >> 16) & 0xFF;
            out.push(CacheInfo(level = 1, kind = "instruction", size = (l1.edx >> 24) * 1024,
                ways = if (ways == 0xFF) { 0 } else { ways }, line = l1.edx & 0xFF, shared_by = 0));
        }
    }
    if (max >= EXTENDED_BASE + 6) {
        let l23 = lookup(snap, EXTENDED_BASE + 6, 0);
        # Associativity code 0 means the cache is disabled.
        if ((l23.ecx >> 16) > 0 and ((l23.ecx >> 12) & 0xF) != 0) {
            out.push(CacheInfo(level = 2, kind = "unified", size = (l23.ecx >> 16) * 1024,
                ways = amd_ways((l23.ecx >> 12) & 0xF), line = l23.ecx & 0xFF, shared_by = 0));
        }
        if ((l23.edx >> 18) > 0 and ((l23.edx >> 12) & 0xF) != 0) {
            out.push(CacheInfo(level = 3, kind = "unified", size = (l23.edx >> 18) * 512 * 1024,
                ways = amd_ways((l23.edx >> 12) & 0xF), line = l23.edx & 0xFF, shared_by = 0));
        }
    }
    return out;
}

# The cache hierarchy: leaf 4 if it reports any cache (Intel, and others
# that implement it), else AMD's leaf 0x8000001D, else the legacy AMD leaves.
pub func caches(snap: Snapshot): list[CacheInfo] {
    let from_leaf4 = caches_from_leaf(snap, 4);
    if (from_leaf4.len() > 0) {
        return from_leaf4;
    }
    let from_amd = caches_from_leaf(snap, EXTENDED_BASE + 0x1D);
    if (from_amd.len() > 0) {
        return from_amd;
    }
    return legacy_amd_caches(snap);
}

# Whether `name` is in the feature table (no snapshot needed).
pub func is_known_flag(name: string): bool {
    for (feat in feature_table()) {
        if (feat.name == name) {
            return true;
        }
    }
    return false;
}
