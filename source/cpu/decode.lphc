@mode(host.native)

# Pure decoding of a cpuid Snapshot: vendor, brand, signature, hypervisor,
# address sizes, feature flags and caches. Nothing here executes CPUID.
#
# Runtime: host.native. Compiled into the native binary build/cpuid by
# `make build` (Stage0 native build). tests/decode_test.lphc runs it in
# native test binaries against the recorded snapshots in tests/samples.lphc.
#
# Structure: three sections. Identity: register text, vendor, brand,
# signature, hypervisor and address sizes. Feature flags: a table of
# /proc/cpuinfo names with the leaf, register and bit of each. Caches: the
# deterministic cache leaves (Intel leaf 4, AMD 0x8000001D), falling back to
# AMD's legacy leaves 0x80000005 and 0x80000006.

from cpu.insn import (Regs);
from cpu.snapshot import (Snapshot, lookup, HYPERVISOR_BASE, EXTENDED_BASE);
from text import (trim_spaces);

# The register `reg` ("eax", "ebx", "ecx", "edx") of a Regs value.
# (if/else rather than `match`: the Stage0 native lane sends every string
# `match` to its `_` arm.)
pub func reg_value(r: Regs, reg: string): int {
    if (reg == "eax") {
        return r.eax;
    } else if (reg == "ebx") {
        return r.ebx;
    } else if (reg == "ecx") {
        return r.ecx;
    }
    return r.edx;
}

# The four bytes of a register as ASCII, least significant byte first,
# skipping NULs.
pub func reg_text(value: int): string {
    var s = "";
    for (i in 0..4) {
        let byte = (value >> (8 * i)) & 0xFF;
        if (byte != 0) {
            s += str(char.of(byte));
        }
    }
    return s;
}

# Highest basic and extended leaves (EAX of leaves 0 and 0x80000000).
pub func max_basic_leaf(snap: Snapshot): int {
    return lookup(snap, 0, 0).eax;
}

pub func max_extended_leaf(snap: Snapshot): int {
    return lookup(snap, EXTENDED_BASE, 0).eax;
}

# "GenuineIntel", "AuthenticAMD", ...: EBX, EDX, ECX of leaf 0, in that order.
pub func vendor(snap: Snapshot): string {
    let r = lookup(snap, 0, 0);
    return reg_text(r.ebx) + reg_text(r.edx) + reg_text(r.ecx);
}

# The 48-byte brand string from leaves 0x80000002-0x80000004, with NULs
# dropped and leading and trailing blanks removed (as Linux does for
# "model name"); "(not reported)" if the leaves do not exist.
pub func brand(snap: Snapshot): string {
    if (max_extended_leaf(snap) < EXTENDED_BASE + 4) {
        return "(not reported)";
    }
    var s = "";
    for (leaf in EXTENDED_BASE + 2..EXTENDED_BASE + 5) {
        let r = lookup(snap, leaf, 0);
        s += reg_text(r.eax) + reg_text(r.ebx) + reg_text(r.ecx) + reg_text(r.edx);
    }
    let trimmed = trim_spaces(s);
    return if (trimmed.len() == 0) { "(not reported)" } else { trimmed };
}

pub struct Signature {
    pub family: int;
    pub model: int;
    pub stepping: int;
    pub raw: int;
}

# Family, model and stepping from leaf 1 EAX, combined the way the Linux
# kernel does it (arch/x86/lib/cpu.c): the extended family is added only to
# base family 0xF, the extended model is prepended from family 6 up.
pub func signature_of(eax: int): Signature {
    let base_family = (eax >> 8) & 0xF;
    let ext_family = (eax >> 20) & 0xFF;
    let base_model = (eax >> 4) & 0xF;
    let ext_model = (eax >> 16) & 0xF;
    let family = if (base_family == 0xF) { base_family + ext_family } else { base_family };
    let model = if (family >= 6) { (ext_model << 4) + base_model } else { base_model };
    return Signature(family = family, model = model, stepping = eax & 0xF, raw = eax);
}

pub func signature(snap: Snapshot): Signature {
    return signature_of(lookup(snap, 1, 0).eax);
}

# The hypervisor vendor ("KVMKVMKVM", "Microsoft Hv", ...) when leaf 1 ECX
# bit 31 says one is present, else None.
pub func hypervisor(snap: Snapshot): Option[string] {
    if (((lookup(snap, 1, 0).ecx >> 31) & 1) == 0) {
        return None;
    }
    let r = lookup(snap, HYPERVISOR_BASE, 0);
    let name = trim_spaces(reg_text(r.ebx) + reg_text(r.ecx) + reg_text(r.edx));
    return Some(if (name.len() == 0) { "(unnamed)" } else { name });
}

# Physical and virtual address widths in bits from 0x80000008 EAX, or
# (0, 0) if the leaf is absent.
pub func address_bits(snap: Snapshot): (int, int) {
    if (max_extended_leaf(snap) < EXTENDED_BASE + 8) {
        return (0, 0);
    }
    let eax = lookup(snap, EXTENDED_BASE + 8, 0).eax;
    return (eax & 0xFF, (eax >> 8) & 0xFF);
}

# ---------------------------------------------------------------------------
# Feature flags

# One flag: where it lives and what it means. Names are the Linux
# /proc/cpuinfo names.
pub struct Feature {
    pub name: string;
    pub leaf: int;
    pub subleaf: int;
    pub reg: string;
    pub bit: int;
    pub desc: string;
}

pub struct FeatureState {
    pub feature: Feature;
    pub present: bool;
}

func f(name: string, leaf: int, subleaf: int, reg: string, bit: int, desc: string): Feature {
    return Feature(name = name, leaf = leaf, subleaf = subleaf, reg = reg, bit = bit, desc = desc);
}

pub func feature_table(): list[Feature] {
